{
  "name": "dsh-relay-pair",
  "version": "0.4.1",
  "private": true,
  "description": "Pair a DSH device (desktop or phone) with a DSH relay: cloud account state, optional task history sync, off-machine task dispatch, and a tunnel for reading the local DSH state from the relay web page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "cordis": "*"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
