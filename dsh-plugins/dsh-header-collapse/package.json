{
  "name": "dsh-header-collapse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collapse the conversation header plugin pills into an ellipsis when the UI gets narrow, and reopen them in a roomy secondary panel.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "cordis": "*",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
