{
  "name": "dsh-font-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "字体实验室：扫描本机已安装字体，用 Font Lab 风格的面板列出来看",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "cordis": "*"
  }
}
