{
  "name": "dsha-relay-pair",
  "version": "0.3.1",
  "private": true,
  "description": "把一台安卓手机（DSHA）配到 DSH 中继台：手机在线时任务投到手机上跑，手机离线时由桌面端或云端接手。手机侧的额外职责是「通知、落盘、重放」——中继给的任务一定看得见，跑完的结果一定回得去。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./protocol": "./lib/protocol.js",
    "./bridge": "./lib/bridge.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "config.example.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "dshhub": {
      "schemaVersion": 1,
      "displayName": "DSHA 中继配对（手机端）",
      "summary": "让手机上的 DSHA 接进 DSH 中继台：收任务、跑任务、回结果，任务来了弹通知，结果丢了会重放。",
      "categories": [
        "android",
        "relay",
        "integration"
      ],
      "surfaces": [
        "tool"
      ],
      "capabilities": {
        "provides": [
          "relay_pair",
          "relay_status",
          "relay_task_add",
          "relay_tasks",
          "relay_sync_task",
          "relay_unpair"
        ],
        "reads": [
          "$DSH_HOME/relay-device.json",
          "$DSH_HOME/relay-local-tasks.jsonl",
          "$DSH_HOME/relay-outbox.jsonl"
        ],
        "network": [
          "https://",
          "http://127.0.0.1:3090"
        ]
      },
      "compatibility": {
        "dsh": ">=0.1.5-rc.1",
        "node": ">=20"
      }
    }
  },
  "peerDependencies": {
    "cordis": "*"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
